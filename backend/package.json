{
  "name": "gpt-automation-backend",
  "version": "1.0.0",
  "description": "Express server and python integration for GPT Desktop automation",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "login": "node scripts/chatgpt_headless.js login",
    "test:headless": "node scripts/chatgpt_headless.js test",
    "chat": "node scripts/chatgpt_headless.js chat",
    "chat:visible": "node scripts/chatgpt_headless.js chat --visible"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.1",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
