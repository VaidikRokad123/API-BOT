# ==============================================================================
# AI AUTOMATION AGENT & LLM API — DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Network
PORT=3000
NODE_ENV=production
HEADLESS=false
ENABLE_VNC=true
VNC_PORT=6080

# Optional API Security (If set, requests to /v1/* require Bearer token or x-api-key)
# LLM_API_KEY=your-secret-api-key

# Optional Proxy Configuration (Useful for cloud deployment to bypass datacenter IP blocks)
# PROXY_SERVER=http://username:password@proxy-host:port
# PROXY_BYPASS=localhost,127.0.0.1

# Database (Optional)
# MONGODB_URI=mongodb+srv://...

# ------------------------------------------------------------------------------
# BASE64 SESSION TOKENS (Optional for Docker Compose because ./backend/session is mounted,
# but REQUIRED when deploying to Render, Railway, Fly.io, or VPS without volume mounts)
#
# Generate these by running locally: npm run export-sessions
# ------------------------------------------------------------------------------
# SESSION_CHATGPT_BASE64=
# SESSION_GROK_BASE64=
# SESSION_GEMINI_BASE64=
# SESSION_PERPLEXITY_BASE64=
# SESSION_DEEPSEEK_BASE64=
